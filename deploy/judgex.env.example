# JudgeX runtime environment.
#
# Copy to /etc/judgex/judgex.env, then:
#   sudo chown root:judgex /etc/judgex/judgex.env && sudo chmod 640 /etc/judgex/judgex.env
# Never commit the filled-in file: it holds the database password and the JWT secret.

# --- database ---------------------------------------------------------------
JUDGEX_DB_USER=judgex
JUDGEX_DB_PASSWORD=CHANGE_ME_db_password

# --- auth -------------------------------------------------------------------
# 32+ random characters. Anyone who knows this can forge an admin token.
JUDGEX_JWT_SECRET=CHANGE_ME_64_hex_characters

# --- sandbox ----------------------------------------------------------------
# docker is mandatory on a public host; local runs submitted code as this user.
JUDGEX_SANDBOX=docker
# Empty = the container's default user. That is root inside the container, but
# --cap-drop ALL also removes CAP_DAC_OVERRIDE, so it cannot write .class files
# into a /work dir owned by the `judgex` user. Set the app's own ids instead:
#   id judgex          -> uid=996(judgex) gid=988(judgex)
#   JUDGEX_SANDBOX_USER=996:988
JUDGEX_SANDBOX_USER=CHANGE_ME_uid:gid_from_id_judgex
JUDGEX_WORK_DIR=/var/lib/judgex/work

# --- capacity ---------------------------------------------------------------
# 2 vCPU box: two judge slots already saturate it.
JUDGEX_WORKER_CONCURRENCY=2
JUDGEX_SUBMIT_RATE=15

# --- first boot accounts ----------------------------------------------------
# Only used while the users table is empty. Set real passwords here, then you can
# leave seeding on (it never overwrites existing rows) or turn it off.
JUDGEX_SEED_ENABLED=true
JUDGEX_ADMIN_PASSWORD=CHANGE_ME_admin_password
JUDGEX_STUDENT_PASSWORD=CHANGE_ME_student_password

# --- middleware (both optional) --------------------------------------------
# Without a broker the outbox rows simply wait; judging is unaffected.
JUDGEX_MQ_ENABLED=false
# JUDGEX_MQ_NAMESRV=127.0.0.1:9876
# JUDGEX_REDIS_PASSWORD=
